# Copy to backend/.env and fill in. Never commit the real .env file.

# ── Core ────────────────────────────────────────────────────────────────────
# On the server set this line so manage.py uses production settings.
# Leave it out locally (development settings are the default).
# DJANGO_SETTINGS_MODULE=config.settings.production
#
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=False
# Comma-separated hostnames the API is served from.
ALLOWED_HOSTS=YOUR_USERNAME.pythonanywhere.com

# ── Database ────────────────────────────────────────────────────────────────
# LEAVE EMPTY to use SQLite (the file backend/db.sqlite3): local development and
# PythonAnywhere's free plan, which has no MySQL/PostgreSQL. Only set this to switch database:
#   sqlite:////home/YOUR_USERNAME/Nsame-reneportfolio/backend/db.sqlite3   (explicit path, 4 slashes)
#   mysql://USER:PASSWORD@HOST/NAME           (paid plan; pip install mysqlclient)
#   postgres://USER:PASSWORD@HOST:5432/NAME   (paid plan; pip install "psycopg[binary]")
# Percent-encode special characters in the password; "$" in a name becomes %24.
DATABASE_URL=

# ── Frontend / CORS ─────────────────────────────────────────────────────────
# The Vercel site allowed to call this API (no trailing slash). Comma-separate
# several origins, e.g. the vercel.app URL plus your custom domain.
FRONTEND_URL=https://your-portfolio.vercel.app
# Optional: regex(es) for Vercel preview deployments, comma-separated.
# CORS_ALLOWED_ORIGIN_REGEXES=^https://your-portfolio-[a-z0-9-]+\.vercel\.app$
# Optional: only needed if the Django admin is served from a custom domain.
# CSRF_TRUSTED_ORIGINS=https://api.example.com

# ── Email (optional: forward contact-form messages to you) ──────────────────
# Leave EMAIL_HOST empty to only store messages (visible in Django admin).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
CONTACT_NOTIFY_EMAIL=

# ── Optional tuning ─────────────────────────────────────────────────────────
# ADMIN_URL=admin/          # change to hide the admin, e.g. manage-7f3k/
# JWT_LIFETIME_HOURS=24
# MAX_UPLOAD_SIZE_MB=5
# THROTTLE_LOGIN=10/min
# THROTTLE_CONTACT=10/hour
# THROTTLE_TESTIMONIAL=10/hour
# SECURE_HSTS_SECONDS=31536000
